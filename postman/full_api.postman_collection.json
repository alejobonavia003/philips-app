{
  "info": {
    "name": "Philips - Full API",
    "_postman_id": "philips-full-api-001",
    "description": "Collection para testear todos los endpoints del servidor (smoke tests)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Todos",
      "item": [
        {
          "name": "Create Todo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"title\": \"Test Todo\",\n  \"description\": \"creado por postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/todos",
              "host": ["{{base_url}}"],
              "path": ["todos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 2xx', function() { pm.expect(pm.response.code).to.be.within(200,299); });",
                  "pm.test('Response is JSON', function() { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Todos by User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/todos/user/1",
              "host": ["{{base_url}}"],
              "path": ["todos", "user", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 2xx', function() { pm.expect(pm.response.code).to.be.within(200,299); });",
                  "pm.test('Returns array', function(){ var body = pm.response.json(); pm.expect(body).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Toggle Todo (PUT) - replace {{todo_id}}",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/todos/{{todo_id}}",
              "host": ["{{base_url}}"],
              "path": ["todos", "{{todo_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 2xx', function() { pm.expect(pm.response.code).to.be.within(200,299); });"
                ]
              }
            }
          ]
        }
      ]
    },

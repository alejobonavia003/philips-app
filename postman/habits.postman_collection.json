{
  "info": {
    "name": "Philips - Habits API",
    "_postman_id": "habits-collection-001",
    "description": "Collection para testear endpoints de Habits (backend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Habit",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"name\": \"Meditación\",\n  \"frequency\": \"daily\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/habits",
          "host": ["{{base_url}}"],
          "path": ["habits"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 2xx', function(){ pm.expect(pm.response.code).to.be.within(200,299); });",
              "pm.test('Response has id', function(){ var b=pm.response.json(); pm.expect(b).to.have.property('id'); pm.collectionVariables.set('habit_id', b.id); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Habits by User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/habits/user/1",
          "host": ["{{base_url}}"],
          "path": ["habits", "user", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 2xx', function(){ pm.expect(pm.response.code).to.be.within(200,299); });",
              "pm.test('Returns array', function(){ pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Habit by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/habits/{{habit_id}}",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habit_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx', function(){ pm.expect(pm.response.code).to.be.within(200,299); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update Habit",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Meditación (20 min)\",\n  \"frequency\": \"daily\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/habits/{{habit_id}}",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habit_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx', function(){ pm.expect(pm.response.code).to.be.within(200,299); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Delete Habit",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/habits/{{habit_id}}",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habit_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx or 404', function(){ pm.expect([200,204,404]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Add Habit Log (create/update)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-01-08\",\n  \"completed\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/habits/{{habit_id}}/logs",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habit_id}", "logs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx', function(){ pm.expect(pm.response.code).to.be.within(200,299); });",
              "pm.test('Has log id', function(){ var b=pm.response.json(); if(b.id) pm.collectionVariables.set('habit_log_id', b.id); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Habit Logs (range)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/habits/{{habit_id}}/logs?start=2026-01-01&end=2026-01-31",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habit_id}", "logs"],
          "query": [
            { "key": "start", "value": "2026-01-01" },
            { "key": "end", "value": "2026-01-31" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx', function(){ pm.expect(pm.response.code).to.be.within(200,299); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Habit Log by Date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/habits/{{habit_id}}/logs/2026-01-08",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habit_id}", "logs", "2026-01-08"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx or 404', function(){ pm.expect([200,404]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update Habit Log",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"completed\": false\n}" },
        "url": {
          "raw": "{{base_url}}/habits/logs/{{habit_log_id}}",
          "host": ["{{base_url}}"],
          "path": ["habits", "logs", "{{habit_log_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx or 404', function(){ pm.expect([200,404]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Delete Habit Log",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/habits/logs/{{habit_log_id}}",
          "host": ["{{base_url}}"],
          "path": ["habits", "logs", "{{habit_log_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx or 404', function(){ pm.expect([200,204,404]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "habit_id", "value": "1" }
  ]
}
